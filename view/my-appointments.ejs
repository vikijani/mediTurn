<!DOCTYPE html>
<html lang="fa">

<head>
    <meta charset="UTF-8">
    <title>نوبت‌های من</title>
    <style>
        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 8px;
            border: 1px solid #ccc;
            text-align: center;
        }

        .pending {
            color: orange;
        }

        .confirmed {
            color: green;
        }

        .canceled {
            color: red;
        }

        button {
            padding: 4px 8px;
            cursor: pointer;
        }
    </style>
</head>

<body>

    <h2>نوبت‌های من</h2>

    <table>
        <thead>
            <tr>
                <th>پزشک</th>
                <th>تاریخ</th>
                <th>ساعت</th>
                <th>وضعیت</th>
                <th>عملیات</th>
            </tr>
        </thead>

        <tbody>
            <% if (appointments.length===0) { %>
                <tr>
                    <td colspan="5">نوبتی ثبت نشده</td>
                </tr>
                <% } %>

                    <% appointments.forEach(appointment=> { %>
                        <tr>
                            <td>
                                <%= appointment.doctorId.name %>
                            </td>
                            <td>
                                <%= appointment.date %>
                            </td>
                            <td>
                                <%= appointment.time %>
                            </td>

                            <td class="status <%= a.status %>">
                                <% if (a.status==="pending" ) { %>
                                    در حال بررسی
                                    <% } else if (a.status==="confirmed" ) { %>
                                        تایید شده
                                        <% } else { %>
                                            لغو شده
                                            <% } %>
                            </td>

                            <td>
                                <% if (a.status !=="canceled" ) { %>
                                    <form method="POST" action="/appointments/<%= a._id %>/cancel">
                                        <button class="btn cancel">لغو</button>
                                    </form>
                                    <% } %>
                            </td>
                        </tr>
                        <% }) %>
        </tbody>
    </table>

    <br>

    <div>
        <% if (currentPage> 1) { %>
            <a href="?page=<%= currentPage - 1 %>">قبلی</a>
            <% } %>

                صفحه <%= currentPage %> از <%= totalPages %>

                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %>">بعدی</a>
                            <% } %>
    </div>

</body>

</html>