<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <title>نوبت‌های من</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header class="top-bar">
  <div class="logo">mediTurn</div>
</header>

<div class="layout">

  <main class="content">
    <h3>نوبت‌های من</h3>

    <table>
      <thead>
        <tr>
          <th><%= user.role === "doctor" ? "بیمار" : "دکتر" %></th>
          <th>تاریخ</th>
          <th>ساعت</th>
          <th>وضعیت</th>
        </tr>
      </thead>

      <tbody>
        <% if (appointments.length === 0) { %>
          <tr>
            <td colspan="4">نوبتی ثبت نشده</td>
          </tr>
        <% } %>

        <% appointments.forEach(a => { %>
          <tr>
            <td>
              <% if (user.role === "doctor") { %>
                <%= a.patientId && a.patientId.name ? a.patientId.name : '—' %>
              <% } else { %>
                <%= a.doctorId && a.doctorId.name ? a.doctorId.name : '—' %>
              <% } %>
            </td>
            <td><%= a.date %></td>
            <td><%= a.time %></td>

            <td class="status <%= a.status %>">
              <% if (a.status === "pending") { %>
                در حال بررسی
              <% } else if (a.status === "confirmed") { %>
                رزرو شده
              <% } else { %>
                لغو شده
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </main>

  <aside class="sidebar">
    <div class="profile">
      <div class="avatar">
        <img src="/images/profile.jpg" alt="پروفایل" width="90" height="90">
      </div>
      <p><%= user.role === "doctor" ? "دکتر" : "بیمار" %></p>
      <p><%= user.name %></p>
    </div>

    <nav class="menu">
      <a href="/appointments/view">رزرو نوبت</a>
      <a href="/my-appointments" class="active">نوبت‌های من</a>
    </nav>

    <a href="/logout" class="logout">خروج از حساب</a>
  </aside>

</div>

</body>
</html>
